# Local development PostgreSQL connection
PORT=4002
DB_URL=jdbc:postgresql://localhost:5432/govcare_ehr_v2
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=change-this-development-secret-to-at-least-32-characters
CORS_ORIGIN=http://127.0.0.1:5300,http://localhost:5300,http://127.0.0.1:5173,http://localhost:5173
# Dedicated Spring-to-Django service credential: a literal random UTF-8 secret of >=32 bytes.
# Configure the same value in ML_Server/.env. Never reuse JWT_SECRET or expose this to React.
# Preferred local ML address. dev:renal shares an available fallback at runtime.
GOVCARE_RENAL_ML_URL=http://127.0.0.1:8001
GOVCARE_RENAL_JWT_SECRET=
GOVCARE_RENAL_ML_TIMEOUT_SECONDS=15
