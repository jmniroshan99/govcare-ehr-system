VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIELD_ENCRYPTION_PASSPHRASE=

# Cloud Functions runtime secrets. Set these with `firebase functions:secrets:set`
# or your deployment secret manager. Do not expose them in frontend builds.
OTP_PEPPER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Optional: Firebase Storage may require Blaze plan for production-scale uploads.
VITE_STORAGE_UPLOAD_MAX_MB=20
