# GovCare EHR frontend/API configuration
VITE_API_BASE_URL=http://127.0.0.1:4001
VITE_MEDIA_API_BASE_URL=http://127.0.0.1:4002

# Keycloak / OAuth 2.0 / OpenID Connect
VITE_KEYCLOAK_URL=http://127.0.0.1:8080
VITE_KEYCLOAK_REALM=govcare
VITE_KEYCLOAK_CLIENT_ID=govcare-ehr-frontend

# Client-side field encryption helper for local/demo mode only.
# Production key management must be server-side/KMS backed.
VITE_FIELD_ENCRYPTION_PASSPHRASE=

# Upload limits enforced again on backend.
VITE_STORAGE_UPLOAD_MAX_MB=20

# Backend email/OTP provider placeholders. Store real values in server-side env only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
