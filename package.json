{
  "name": "govcare-ehr-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "backup:local": "powershell -ExecutionPolicy Bypass -File scripts/local-backup.ps1",
    "backup:local:zip": "powershell -ExecutionPolicy Bypass -File scripts/local-backup.ps1 -Zip",
    "node:check": "node scripts/validate-node-version.mjs",
    "functions:install": "npm --prefix firebase/functions install",
    "functions:build": "npm --prefix firebase/functions run build",
    "firebase:init": "npm run node:check && firebase use healthapp-462e7 && npm run functions:install",
    "firebase:emulators": "npm run node:check && npm run functions:build && firebase emulators:start --only auth,firestore,functions,hosting,storage",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "firebase:deploy:functions": "npm run node:check && npm run functions:build && firebase deploy --only functions",
    "firebase:deploy:hosting": "npm run build && firebase deploy --only hosting",
    "firebase:deploy:all": "npm run node:check && npm run build && npm run functions:build && firebase deploy",
    "firebase:deploy": "npm run firebase:deploy:all"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.10",
    "file-saver": "^2.0.5",
    "firebase": "^12.14.0",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.18.0",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
