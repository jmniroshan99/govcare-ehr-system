{
  "name": "govcare-ehr-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:detached": "node scripts/start-dev-detached.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "backup:local": "powershell -ExecutionPolicy Bypass -File scripts/local-backup.ps1",
    "backup:local:zip": "powershell -ExecutionPolicy Bypass -File scripts/local-backup.ps1 -Zip",
    "node:check": "node scripts/validate-node-version.mjs",
    "postgres:install": "npm run spring:install",
    "postgres:api": "npm run spring:api",
    "postgres:build": "npm run spring:build",
    "spring:api": "node scripts/run-spring.mjs run",
    "spring:build": "node scripts/run-spring.mjs build",
    "test:startup": "node --test scripts/run-spring.test.mjs scripts/run-full-stack.test.cjs scripts/api-port.test.cjs scripts/run-renal-stack.test.cjs scripts/renal-port.test.cjs scripts/renal-ml-env.test.cjs scripts/renal-local-config.test.cjs",
    "dev:full": "node scripts/run-full-stack.cjs",
    "dev:open": "node scripts/start-full-dev.cjs",
    "dev:all-services": "npm run dev:full",
    "start:all": "npm run dev:open",
    "spring:install": "node scripts/check-spring.mjs",
    "test:roles": "node --test scripts/role-access.test.cjs",
    "test:dashboard": "node --test scripts/role-dashboard-contract.test.cjs",
    "accounts:local": "node scripts/provision-local-role-accounts.mjs",
    "verify:roles": "node scripts/verify-role-logins.mjs",
    "demo:seed": "node scripts/seed-demo-network.mjs seed",
    "demo:verify": "node scripts/seed-demo-network.mjs verify",
    "test:demo": "node --test scripts/demo-network.test.mjs",
    "test:superadmin": "node --test scripts/superadmin-navigation.test.cjs scripts/facility-administration.test.cjs && node scripts/test-superadmin-java.mjs",
    "test:facilities": "node --test scripts/facility-administration.test.cjs",
    "theme:generate": "node scripts/generate-theme.mjs",
    "prebuild": "npm run theme:generate",
    "predev": "npm run theme:generate",
    "test:theme": "node scripts/generate-theme.mjs --check && node --test scripts/theme.test.mjs",
    "test:theme:browser": "node scripts/verify-theme-browser.mjs",
    "test:java:syntax": "node scripts/check-java-syntax.mjs",
    "test:patient-registration": "node --test scripts/patient-registration.test.cjs && node scripts/verify-patient-registration-migration.mjs",
    "test:doctor-workspace": "node --test scripts/doctor-workspace-profile.test.cjs",
    "test:searchable-select": "node --test scripts/searchable-select-placement.test.cjs",
    "test:predictive": "node scripts/test-predictive-domain.mjs && node --test scripts/predictive-access.test.cjs && node scripts/verify-predictive-migration.mjs",
    "test:predictive:browser": "node scripts/verify-predictive-browser.mjs",
    "test:ckd-workspace": "node --test scripts/ckd-workspace.test.cjs",
    "test:disease-probabilities": "node --test scripts/disease-probabilities.test.cjs && node scripts/test-disease-probability-domain.mjs && node scripts/verify-disease-probability-migration.mjs",
    "renal:configure": "node scripts/configure-renal-local.cjs",
    "renal:ml": "node scripts/run-renal-ml.cjs",
    "dev:renal": "node scripts/run-renal-stack.cjs",
    "test:renal:migration": "node scripts/verify-renal-migration.mjs",
    "test:renal:browser": "node scripts/verify-renal-browser.mjs",
    "test:renal:graphics": "node --test scripts/renal-clinical-risk-graphics.test.cjs",
    "renal:train:hyperkalemia": "python ml-training/train_hyperkalemia_from_packaged.py",
    "test:renal:runtime": "node --test scripts/renal-ml-env.test.cjs scripts/renal-port.test.cjs scripts/run-renal-stack.test.cjs scripts/renal-local-config.test.cjs",
    "test:renal:startup:live": "node --test scripts/renal-port-live.test.cjs",
    "test:postgres:v42": "node scripts/verify-live-postgres-v42.mjs",
    "test:ckd:pdf:live": "node scripts/verify-live-ckd-pdf.mjs",
    "test:renal:api-contracts": "node --test scripts/renal-api-contracts.test.cjs",
    "test:renal:six-modules": "node --test scripts/renal-clinical-risk-graphics.test.cjs scripts/renal-api-contracts.test.cjs && node scripts/verify-renal-six-module-migration.mjs",
    "test:renal:six-modules:browser": "node scripts/verify-renal-six-modules-browser.mjs",
    "test:postgres:v43": "node scripts/verify-live-postgres-v43.mjs",
    "test:renal:readiness": "node --test scripts/renal-api-contracts.test.cjs scripts/renal-clinical-risk-graphics.test.cjs && node scripts/verify-renal-dialysis-context-migration.mjs",
    "test:renal:readiness:browser": "node scripts/verify-renal-readiness-browser.mjs",
    "test:postgres:v44": "node scripts/verify-live-postgres-v44.mjs",
    "test:ckd:features": "node --test scripts/renal-api-contracts.test.cjs scripts/clinical-feature-contracts.test.cjs && node scripts/verify-clinical-feature-migration.mjs",
    "test:ckd:features:browser": "node scripts/verify-clinical-feature-browser.mjs",
    "test:postgres:v45": "node scripts/verify-live-postgres-v45.mjs",
    "test:ckd:dashboard": "node --test scripts/ckd-clinical-dashboard.test.cjs scripts/renal-clinical-risk-graphics.test.cjs scripts/renal-api-contracts.test.cjs scripts/clinical-feature-contracts.test.cjs",
    "test:ckd:dashboard:browser": "node scripts/verify-ckd-clinical-dashboard-browser.mjs",
    "renal:train:packaged": "python ml-training/train_packaged_models.py",
    "test:ckd:outlook": "node --test scripts/ckd-outlook.test.cjs scripts/ckd-workspace.test.cjs",
    "test:ckd:outlook:migration": "node scripts/verify-ckd-outlook-migration.mjs",
    "test:ckd:outlook:browser": "node scripts/verify-ckd-outlook-browser.mjs",
    "test:ckd:evidence": "node --test scripts/ckd-evidence.test.cjs",
    "test:ckd:evidence:migration": "node scripts/verify-ckd-evidence-migration.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.10",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.18.0",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "7.11.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "@electric-sql/pglite": "0.5.8"
  }
}
