{
  "name": "govcare-ehr-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:detached": "node scripts/start-dev-detached.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "backup:local": "powershell -ExecutionPolicy Bypass -File scripts/local-backup.ps1",
    "backup:local:zip": "powershell -ExecutionPolicy Bypass -File scripts/local-backup.ps1 -Zip",
    "node:check": "node scripts/validate-node-version.mjs",
    "postgres:install": "npm run spring:install",
    "postgres:api": "npm run spring:api",
    "postgres:build": "npm run spring:build",
    "spring:api": "node scripts/run-spring.mjs run",
    "spring:build": "node scripts/run-spring.mjs build",
    "dev:full": "concurrently -k -n FRONTEND,SPRING_API -c cyan,green \"npm run dev -- --host 127.0.0.1 --port 5300 --strictPort\" \"npm run spring:api\"",
    "dev:open": "node scripts/start-full-dev.cjs",
    "dev:all-services": "concurrently -k -n FRONTEND,SPRING_API -c cyan,green \"npm run dev -- --host 127.0.0.1 --port 5300 --strictPort\" \"npm run spring:api\"",
    "start:all": "npm run dev:open",
    "spring:install": "node scripts/check-spring.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.10",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.18.0",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "7.11.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
