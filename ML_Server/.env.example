# Run npm run renal:configure to set the same dedicated random secret in both services.
GOVCARE_RENAL_JWT_SECRET=
RENAL_ML_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional preferred local port: GOVCARE_RENAL_ML_PORT=18001
# dev:renal chooses a permitted port and passes the same address to Spring.
# Set GOVCARE_RENAL_ML_PORT in the terminal to pin a port without fallback.
