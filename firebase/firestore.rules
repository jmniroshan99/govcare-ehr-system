rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function hospitalId() {
      return request.auth.token.hospitalId;
    }

    function patientId() {
      return request.auth.token.patientId;
    }

    function sameHospital() {
      return signedIn() && resource.data.hospitalId == hospitalId();
    }

    function patientOwnsRecord() {
      return signedIn() && role() == 'patient' && (
        resource.data.patientId == patientId()
        || resource.data.patientUid == request.auth.uid
        || resource.data.ownerUid == request.auth.uid
        || resource.data.guardianUid == request.auth.uid
      );
    }

    function releasedToPatient() {
      return patientOwnsRecord() && resource.data.releaseStatus in ['released', 'approved'];
    }

    function patientOwnUpload() {
      return patientOwnsRecord() && resource.data.createdBy == request.auth.uid;
    }

    function mediaStaffRoles() {
      return ['super_admin', 'hospital_admin', 'doctor', 'surgeon', 'anesthetist', 'nurse', 'pharmacist', 'pathologist', 'lab_manager', 'lab_technician', 'radiologist', 'radiology_technician', 'receptionist', 'mortuary_officer', 'ict_admin', 'records_officer'];
    }

    function incomingSameHospital() {
      return signedIn() && request.resource.data.hospitalId == hospitalId();
    }

    function admin() {
      return role() in ['super_admin', 'hospital_admin', 'ict_admin'];
    }

    function hasRole(roles) {
      return signedIn() && role() in roles;
    }

    function selfProfileUpdateOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['displayName', 'phone', 'address', 'city', 'district', 'hospitalCity', 'preferredHospital', 'preferredLanguage', 'emergencyContactName', 'emergencyContactPhone', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function immutableAuditFields() {
      return !('createdAt' in request.resource.data.diff(resource.data).changedKeys())
        && !('createdBy' in request.resource.data.diff(resource.data).changedKeys())
        && !('hospitalId' in request.resource.data.diff(resource.data).changedKeys());
    }

    match /hospitals/{id} {
      allow read: if signedIn() && (id == hospitalId() || role() == 'super_admin');
      allow create, update, delete: if role() == 'super_admin';
    }

    match /departments/{id} {
      allow read: if sameHospital();
      allow create, update, delete: if admin() && incomingSameHospital();
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || role() == 'super_admin'
        || (admin() && sameHospital())
      );
      allow update: if signedIn()
        && request.auth.uid == uid
        && sameHospital()
        && hasRole(['doctor', 'nurse', 'patient'])
        && selfProfileUpdateOnly();
      allow create, update, delete: if false;
    }

    match /patients/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'surgeon', 'anesthetist', 'nurse', 'pathologist', 'lab_manager', 'lab_technician', 'radiologist', 'radiology_technician', 'receptionist', 'records_officer'])
        || (role() == 'patient' && (resource.data.ownerUid == request.auth.uid || resource.data.guardianUid == request.auth.uid) && resource.data.portalVisible == true)
      );
      allow create: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'receptionist', 'records_officer']);
      allow update: if sameHospital() && incomingSameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer'])
        || (role() == 'patient' && resource.data.ownerUid == request.auth.uid && request.resource.data.diff(resource.data).changedKeys().hasOnly(['phone', 'address', 'city', 'district', 'hospitalCity', 'preferredHospital', 'preferredLanguage', 'emergencyContact', 'updatedAt', 'updatedBy']))
      ) && immutableAuditFields();
      allow delete: if false;
    }

    match /guardians/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'receptionist', 'records_officer'])
        || (role() == 'patient' && resource.data.ownerUid == request.auth.uid)
      );
      allow create, update, delete: if false;
    }

    match /guardianDependents/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'receptionist', 'records_officer'])
        || (role() == 'patient' && resource.data.guardianUid == request.auth.uid)
      );
      allow create, update, delete: if false;
    }

    match /patientFieldConfigurations/{hospitalConfigId} {
      allow read: if signedIn() && (hospitalConfigId == hospitalId() || role() == 'super_admin');
      allow create, update, delete: if false;
    }

    match /visits/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer'])
        || releasedToPatient()
      );
      allow create: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'receptionist']);
      allow update: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'receptionist']);
      allow delete: if false;
    }

    match /opdQueues/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'receptionist', 'records_officer'])
        || releasedToPatient()
      );
      allow create: if incomingSameHospital()
        && hasRole(['super_admin', 'hospital_admin', 'receptionist'])
        && request.resource.data.status in ['waiting', 'emergency-priority'];
      allow update: if incomingSameHospital()
        && sameHospital()
        && hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'receptionist'])
        && request.resource.data.status in ['waiting', 'called', 'in-consultation', 'completed', 'skipped', 'transferred', 'cancelled', 'emergency-priority']
        && immutableAuditFields();
      allow delete: if false;
    }

    match /consultationDrafts/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor']) && (admin() || resource.data.doctorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /doctorApprovals/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'records_officer']);
      allow create, update, delete: if false;
    }

    match /consultations/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer']);
      allow create, update, delete: if false;
    }

    match /telemedicineSessions/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor'])
        || (role() == 'patient' && resource.data.patientId == patientId() && resource.data.releaseStatus in ['released', 'approved'])
      );
      allow create, update, delete: if false;
    }

    match /secureChats/{threadId} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor'])
        || (role() == 'patient' && resource.data.patientId == patientId() && resource.data.patientVisible == true)
      );
      allow create, update, delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/secureChats/$(threadId)).data.hospitalId == hospitalId()
          && (
            role() in ['super_admin', 'hospital_admin', 'doctor']
            || (
              role() == 'patient'
              && get(/databases/$(database)/documents/secureChats/$(threadId)).data.patientId == patientId()
              && get(/databases/$(database)/documents/secureChats/$(threadId)).data.patientVisible == true
              && resource.data.internalOnly != true
            )
          );
        allow create, update, delete: if false;
      }
    }

    match /secureChatThreads/{threadId} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor'])
        || (role() == 'patient' && resource.data.patientId == patientId() && resource.data.patientVisible == true)
      );
      allow create, update, delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/secureChatThreads/$(threadId)).data.hospitalId == hospitalId()
          && (
            role() in ['super_admin', 'hospital_admin', 'doctor']
            || (
              role() == 'patient'
              && get(/databases/$(database)/documents/secureChatThreads/$(threadId)).data.patientId == patientId()
              && get(/databases/$(database)/documents/secureChatThreads/$(threadId)).data.patientVisible == true
              && resource.data.internalOnly != true
            )
          );
        allow create, update, delete: if false;
      }
    }

    match /admissions/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer'])
        || releasedToPatient()
      );
      allow create, update: if false;
      allow delete: if false;
    }

    match /admissionRequests/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'receptionist', 'records_officer']);
      allow create, update, delete: if false;
    }

    match /inpatientNotes/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer']);
      allow create, update: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse']) && immutableAuditFields();
      allow delete: if false;
    }

    match /wardTransfers/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer']);
      allow create, update, delete: if false;
    }

    match /dischargeSummaries/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer'])
        || releasedToPatient()
      );
      allow create, update, delete: if false;
    }

    match /wards/{id} {
      allow read: if sameHospital();
      allow create, update, delete: if false;
    }

    match /beds/{id} {
      allow read: if sameHospital();
      allow create, update, delete: if false;
    }

    match /prescriptions/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'pharmacist', 'records_officer'])
        || releasedToPatient()
      );
      allow create, update: if false;
      allow delete: if false;
    }

    match /medicines/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'pharmacist']);
      allow create, update: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'pharmacist']);
      allow delete: if admin();
    }

    match /pharmacyQueue/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'pharmacist', 'records_officer']);
      allow create, update, delete: if false;
    }

    match /medicineStock/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'pharmacist']);
      allow create, update, delete: if false;
    }

    match /medicineIssues/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'pharmacist', 'records_officer'])
        || releasedToPatient()
      );
      allow create, update, delete: if false;
    }

    match /pharmacyReceipts/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'pharmacist', 'records_officer'])
        || releasedToPatient()
      );
      allow create, update, delete: if false;
    }

    match /labRequests/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'pathologist', 'lab_manager', 'lab_technician']);
      allow create: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor']);
      allow update: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'pathologist', 'lab_manager', 'lab_technician', 'doctor']);
      allow delete: if false;
    }

    match /labOrders/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'pathologist', 'lab_manager', 'lab_technician', 'records_officer'])
        || releasedToPatient()
      );
      allow create, update, delete: if false;
    }

    match /labResults/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'pathologist', 'lab_manager', 'lab_technician'])
        || releasedToPatient()
      );
      allow create, update: if false;
      allow delete: if false;
    }

    match /radiologyRequests/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'radiologist', 'radiology_technician']);
      allow create: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor']);
      allow update: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'radiologist', 'radiology_technician']);
      allow delete: if false;
    }

    match /radiologyOrders/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'radiologist', 'radiology_technician', 'records_officer'])
        || releasedToPatient()
      );
      allow create, update, delete: if false;
    }

    match /radiologyReports/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'radiologist', 'radiology_technician'])
        || releasedToPatient()
      );
      allow create, update, delete: if false;
    }

    match /appointments/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'receptionist'])
        || releasedToPatient()
      );
      allow create, update: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'receptionist']);
      allow delete: if admin();
    }

    match /emergencyCases/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'receptionist']);
      allow create, update: if incomingSameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'receptionist']);
      allow delete: if false;
    }

    match /operationTheatreCases/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'surgeon', 'anesthetist', 'nurse']);
      allow create, update: if incomingSameHospital()
        && hasRole(['super_admin', 'hospital_admin', 'surgeon', 'anesthetist', 'nurse'])
        && immutableAuditFields();
      allow delete: if false;
    }

    match /surgeryReports/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'surgeon', 'anesthetist', 'records_officer']);
      allow create, update, delete: if false;
    }

    match /futureCarePlans/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'surgeon', 'nurse', 'records_officer'])
        || releasedToPatient()
      );
      allow create, update: if incomingSameHospital()
        && hasRole(['super_admin', 'hospital_admin', 'doctor', 'surgeon', 'nurse'])
        && immutableAuditFields();
      allow delete: if false;
    }

    match /mortuaryCases/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'mortuary_officer', 'records_officer']);
      allow create, update: if incomingSameHospital()
        && hasRole(['super_admin', 'hospital_admin', 'doctor', 'mortuary_officer'])
        && immutableAuditFields();
      allow delete: if false;
    }

    match /mortuaryCertificates/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'mortuary_officer', 'records_officer']);
      allow create, update, delete: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.userId
        || role() in resource.data.targetRoles
        || role() in resource.data.roles
      ) && resource.data.hospitalId == hospitalId();
      allow create, update, delete: if false;
    }

    match /emailOtps/{id} {
      allow read, write: if false;
    }

    match /reports/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin'])
        || (
          hasRole(['records_officer', 'ict_admin', 'receptionist', 'doctor', 'nurse', 'pharmacist', 'pathologist', 'lab_manager', 'lab_technician', 'radiologist', 'radiology_technician'])
          && resource.data.departmentId == request.auth.token.departmentId
        )
        || releasedToPatient()
        || patientOwnUpload()
      );
      allow create, update, delete: if false;
    }

    match /medicalDecisionRequests/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'records_officer'])
        || (role() == 'patient' && resource.data.patientUid == request.auth.uid)
      );
      allow create, update, delete: if false;
    }

    match /medicalReportDrafts/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'records_officer']);
      allow create, update, delete: if false;
    }

    match /medicalReportApprovals/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'doctor', 'records_officer']);
      allow create, update, delete: if false;
    }

    match /medicalConsentRecords/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'records_officer'])
        || (role() == 'patient' && resource.data.patientUid == request.auth.uid)
      );
      allow create, update, delete: if false;
    }

    match /releasedMedicalDecisionReports/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'records_officer'])
        || (role() == 'patient' && resource.data.patientUid == request.auth.uid && resource.data.releaseStatus == 'released')
      );
      allow create, update, delete: if false;
    }

    match /vaccinationRecords/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer'])
        || releasedToPatient()
      );
      allow create, update, delete: if false;
    }

    match /billingRecords/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'records_officer', 'receptionist'])
        || releasedToPatient()
      );
      allow create, update, delete: if false;
    }

    match /billingInvoices/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'records_officer', 'receptionist'])
        || releasedToPatient()
      );
      allow create, update, delete: if false;
    }

    match /patientDocuments/{id} {
      allow read: if sameHospital() && (
        hasRole(['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer'])
        || releasedToPatient()
        || patientOwnUpload()
      );
      allow create, update, delete: if false;
    }

    match /globalMedia/{id} {
      allow read: if sameHospital() && (
        role() in mediaStaffRoles()
        || (
          role() == 'patient'
          && resource.data.patientId == patientId()
          && resource.data.visibilityLevel == 'patient-released'
          && resource.data.reviewStatus in ['approved', 'not-required']
        )
      );
      allow create: if incomingSameHospital()
        && (
          role() in mediaStaffRoles()
          || (
            role() == 'patient'
            && request.resource.data.patientId == patientId()
            && request.resource.data.visibilityLevel in ['private', 'patient-released']
          )
        )
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.role == role()
        && request.resource.data.module is string
        && request.resource.data.fileUrl is string
        && request.resource.data.storagePath is string
        && request.resource.data.visibilityLevel in ['private', 'care-team', 'patient-released', 'admin-only']
        && request.resource.data.reviewStatus in ['not-required', 'pending-review', 'approved', 'rejected'];
      allow update: if sameHospital()
        && incomingSameHospital()
        && hasRole(['super_admin', 'hospital_admin', 'doctor', 'records_officer'])
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reviewStatus', 'visibilityLevel', 'description', 'updatedAt', 'updatedBy'])
        && immutableAuditFields();
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if sameHospital() && hasRole(['super_admin', 'hospital_admin', 'ict_admin', 'records_officer']);
      allow create, update, delete: if false;
    }

    match /loginActivities/{id} {
      allow read: if signedIn() && (
        role() == 'super_admin'
        || (hasRole(['hospital_admin', 'ict_admin']) && sameHospital())
      );
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
