rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function hospitalId() {
      return request.auth.token.hospitalId;
    }

    function patientId() {
      return request.auth.token.patientId;
    }

    function mediaStaffRole() {
      return role() in ['super_admin', 'hospital_admin', 'doctor', 'surgeon', 'anesthetist', 'nurse', 'pharmacist', 'pathologist', 'lab_manager', 'lab_technician', 'radiologist', 'radiology_technician', 'receptionist', 'mortuary_officer', 'ict_admin', 'records_officer'];
    }

    match /hospitals/{hospId}/patients/{patientId}/{fileName} {
      allow read: if signedIn() && hospId == hospitalId() && role() in ['super_admin', 'hospital_admin', 'doctor', 'nurse', 'lab_technician', 'radiologist', 'records_officer'];
      allow write: if signedIn() && hospId == hospitalId() && role() in ['super_admin', 'hospital_admin', 'doctor', 'lab_technician', 'radiologist'] && request.resource.size < 20 * 1024 * 1024;
    }

    match /hospitals/{hospId}/reports/{fileName} {
      allow read: if signedIn() && hospId == hospitalId() && role() in ['super_admin', 'hospital_admin', 'records_officer'];
      allow write: if false;
    }

    match /hospitals/{hospId}/medical-decision-reports/{patientUid}/{fileName} {
      allow read: if signedIn() && hospId == hospitalId() && (
        role() in ['super_admin', 'hospital_admin', 'doctor', 'records_officer']
        || (role() == 'patient' && request.auth.uid == patientUid)
      );
      allow write: if false;
    }

    match /hospitals/{hospId}/patients/{patientUid}/reports/{fileName} {
      allow read: if signedIn() && hospId == hospitalId() && (
        role() in ['super_admin', 'hospital_admin', 'doctor', 'records_officer']
      );
      allow write: if signedIn() && hospId == hospitalId() && (
        role() in ['super_admin', 'hospital_admin', 'doctor', 'nurse', 'lab_technician', 'radiologist']
      ) && request.resource.size < 20 * 1024 * 1024;
    }

    match /hospitals/{hospId}/patients/{patientUid}/uploads/{fileName} {
      allow read: if signedIn() && hospId == hospitalId() && (
        role() in ['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer']
        || (role() == 'patient' && request.auth.uid == patientUid)
      );
      allow write: if signedIn() && hospId == hospitalId() && (
        role() == 'patient' && request.auth.uid == patientUid
      ) && request.resource.size < 20 * 1024 * 1024;
    }

    match /hospitals/{hospId}/patients/{patientUid}/released/{fileName} {
      allow read: if signedIn() && hospId == hospitalId() && (
        role() in ['super_admin', 'hospital_admin', 'doctor', 'nurse', 'records_officer']
        || (role() == 'patient' && request.auth.uid == patientUid)
      );
      allow write: if signedIn() && hospId == hospitalId() && (
        role() in ['super_admin', 'hospital_admin', 'doctor', 'nurse', 'lab_technician', 'radiologist']
      ) && request.resource.size < 20 * 1024 * 1024;
    }

    match /hospitals/{hospId}/media/{module}/{patientScope}/{fileName} {
      allow read: if signedIn() && hospId == hospitalId() && (
        mediaStaffRole()
        || (
          role() == 'patient'
          && patientScope == patientId()
          && resource.metadata.visibilityLevel == 'patient-released'
        )
      );
      allow write: if signedIn()
        && hospId == hospitalId()
        && (
          mediaStaffRole()
          || (role() == 'patient' && patientScope == patientId())
        )
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|text/plain');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
